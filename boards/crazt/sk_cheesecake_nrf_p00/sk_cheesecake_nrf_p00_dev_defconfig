CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_SLIMEVR_USB_DEVICE_MANUFACTURER="SlimeVR"
CONFIG_SLIMEVR_USB_DEVICE_PRODUCT="SlimeNRF Tracker SK CheeseCake NRF P00 Dev"

CONFIG_BATTERY_USE_REG_LDO_MAPPING=y
CONFIG_LED_RGB_COLOR=y
CONFIG_LED_STRIP=y
CONFIG_LED_GLOBAL_BRIGHTNESS_PPTT=1000
CONFIG_LED_DEFAULT_COLOR_R=8235
CONFIG_LED_DEFAULT_COLOR_G=6353
CONFIG_LED_DEFAULT_COLOR_B=6667
CONFIG_SPI=y

# Experimental TCAL Heat settings
CONFIG_SYSTEM_IMU_HEATER_MAX_DUTY_PPTT=9900
CONFIG_SENSOR_TCAL_HEATED_DEFAULT_KP=300
CONFIG_SENSOR_TCAL_HEATED_DEFAULT_KI=5
CONFIG_SENSOR_TCAL_HEATED_DEFAULT_KFF=420

# Development image: no UF2 bootloader, no SoftDevice, app starts at flash base.
# CONFIG_BUILD_OUTPUT_UF2 is not set
CONFIG_FLASH_LOAD_OFFSET=0x0
